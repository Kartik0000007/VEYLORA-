# Veylora Backend Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env files to version control.

# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL) — required
DATABASE_URL=postgresql://username:password@localhost:5432/veylora

# JWT Secret — change this to a random strong string in production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Initial administrator provisioning (seed only — used by backend/scripts/seed.js)
# Provide a strong password via ADMIN_PASSWORD. Never commit this file.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@veylora.local
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# CORS — comma-separated list of explicitly allowed frontend origins
# Example: https://veylora.pages.dev,https://admin.veylora.pages.dev,http://localhost:5173
CORS_ORIGIN=

# Secure publish webhook secret (used by CI/CD to trigger rebuilds)
PUBLISH_WEBHOOK_SECRET=CHANGE_ME_STRONG_WEBHOOK_SECRET

# Public site URL (for email links, canonical URLs, etc.)
PUBLIC_SITE_URL=https://veylora.pages.dev

# Admin site URL
ADMIN_SITE_URL=https://admin.veylora.pages.dev
