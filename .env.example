# Veylora Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/veylora

# JWT Secret (change this to a random strong string)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Admin default credentials (only used for seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@veylora.local

# CORS - allow your frontend domains
CORS_ORIGIN=https://veylora.vercel.app,https://admin-dashboard.vercel.app,http://localhost:5173
